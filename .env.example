# Copie este arquivo para .env e preencha. O .env NAO vai para o repositorio.
# Se as variaveis de banco ficarem em branco, o notebook usa o CSV local (CSV_PATH).

DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
